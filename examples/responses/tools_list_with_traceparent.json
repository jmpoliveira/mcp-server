{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "search_customers",
        "description": "Find customers by customer id, name, email or company (case-insensitive,\npartial match). Returns up to max_results customers, each with id, name, email, company\nand plan. Customer records do not include support tickets, so they cannot show whether\na customer has any.",
        "inputSchema": {
          "properties": {
            "query": {
              "description": "Customer id ('C-' followed by digits), name, email or company, or part of one.",
              "title": "Query",
              "type": "string"
            },
            "max_results": {
              "default": 5,
              "description": "Maximum number of customers to return (1-20).",
              "title": "Max Results",
              "type": "integer"
            }
          },
          "required": [
            "query"
          ],
          "title": "search_customers_toolArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "search_customers_toolDictOutput",
          "type": "object"
        },
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        }
      },
      {
        "name": "get_ticket_info",
        "description": "Get one support ticket by its ticket id: title, description, priority,\nstatus, creation date and the id of the customer it belongs to. It cannot list or\nsearch tickets, and customer ids ('C-...') are not ticket ids.",
        "inputSchema": {
          "properties": {
            "ticket_id": {
              "description": "Ticket id: 'T-' followed by digits.",
              "title": "Ticket Id",
              "type": "string"
            }
          },
          "required": [
            "ticket_id"
          ],
          "title": "get_ticket_info_toolArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "get_ticket_info_toolDictOutput",
          "type": "object"
        },
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        }
      },
      {
        "name": "create_ticket",
        "description": "Create a new support ticket for an existing customer.",
        "inputSchema": {
          "properties": {
            "customer_id": {
              "description": "Id of an existing customer as returned by search_customers ('C-' followed by digits).",
              "title": "Customer Id",
              "type": "string"
            },
            "title": {
              "description": "Short summary (max 120 characters).",
              "title": "Title",
              "type": "string"
            },
            "description": {
              "description": "Full problem description (max 2000 characters).",
              "title": "Description",
              "type": "string"
            },
            "priority": {
              "default": "medium",
              "description": "Ticket priority.",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ],
              "title": "Priority",
              "type": "string"
            }
          },
          "required": [
            "customer_id",
            "title",
            "description"
          ],
          "title": "create_ticket_toolArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "create_ticket_toolDictOutput",
          "type": "object"
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        }
      }
    ]
  }
}
