# Copy to .env and fill in the required values. Everything else is optional.

# --- Required ---------------------------------------------------------------
# Address the HTTP server binds to
MCP_HOST=127.0.0.1
MCP_PORT=3000

# --- Environment ------------------------------------------------------------
# local | development | production  (default: production)
# Picks the logging defaults. Use "local" on your machine.
APP_ENV=local

# --- Optional overrides: uncomment only what you want to change -------------
# Profile defaults:
#   local        DEBUG, console, JSONL file
#   development  DEBUG, json,    stdout only
#   production   INFO,  json,    stdout only
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE_ENABLED=false
# LOG_FILE=logs/mcp-server.log.jsonl
# LOG_ACCESS=true
# Caps per log line (200-12000) and the size of the in-memory log queue (>= 100)
# LOG_MAX_MESSAGE_CHARS=4000
# LOG_MAX_STACKTRACE_CHARS=6000
# LOG_QUEUE_SIZE=10000
# SERVICE_VERSION=0.1.0
# MCP_SERVER_NAME=mcp-server

# --- OpenTelemetry (OTLP over HTTP). Endpoint is the base URL ---------------
# With OTEL_ENABLED=false there are NO traces and trace_id/span_id are null in
# the logs. To send traces to Jaeger, set it to true and set the endpoint:
OTEL_ENABLED=false
# OTEL_SERVICE_NAME=mcp-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
